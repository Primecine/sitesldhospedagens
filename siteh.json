    "codigoHtml": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>PatosTurista · by ViaFemini</title>\n\n<link rel=\"manifest\" href=\"manifest.json\">\n<meta name=\"theme-color\" content=\"#8a5cc9\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n<link rel=\"apple-touch-icon\" href=\"icon-180.png\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  :root {\n    --lilac-50:  #faf7ff;\n    --lilac-100: #f4eefc;\n    --lilac-200: #e6d9f7;\n    --lilac-300: #cdb6ec;\n    --lilac-400: #b79ce0;\n    --lilac-500: #9d78d4;\n    --lilac-600: #8a5cc9;\n    --lilac-700: #6f45a8;\n    --rose-100:  #fdeef2;\n    --rose-400:  #f2a7bf;\n    --rose-600:  #d96a8c;\n    --ink:       #1f1a2a;\n    --ink-soft:  #6b6178;\n    --ink-mute:  #9a8eaa;\n    --white:     #ffffff;\n    --bg:        #fbf8ff;\n\n    --shadow-xs: 0 1px 2px rgba(31, 26, 42, 0.04);\n    --shadow-sm: 0 2px 8px rgba(111, 69, 168, 0.06);\n    --shadow-md: 0 8px 24px rgba(111, 69, 168, 0.10);\n    --shadow-lg: 0 20px 48px rgba(111, 69, 168, 0.16);\n    --shadow-xl: 0 30px 80px rgba(111, 69, 168, 0.20);\n\n    --radius-sm: 12px;\n    --radius-md: 18px;\n    --radius-lg: 24px;\n    --radius-xl: 32px;\n  }\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n\n  body {\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n    color: var(--ink);\n    background:\n      radial-gradient(1200px 600px at 10% -10%, rgba(183, 156, 224, 0.18), transparent 60%),\n      radial-gradient(900px 500px at 100% 0%, rgba(242, 167, 191, 0.14), transparent 55%),\n      var(--bg);\n    min-height: 100vh;\n    line-height: 1.55;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n\n  /* ---------- HEADER STICKY ---------- */\n  .topbar {\n    position: sticky;\n    top: 0;\n    z-index: 50;\n    backdrop-filter: saturate(180%) blur(16px);\n    -webkit-backdrop-filter: saturate(180%) blur(16px);\n    background: rgba(251, 248, 255, 0.78);\n    border-bottom: 1px solid rgba(230, 217, 247, 0.7);\n  }\n\n  .topbar-inner {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 14px 24px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n  }\n\n  .brand-block { display: flex; align-items: center; gap: 12px; }\n\n  .logo-mark {\n    width: 42px; height: 42px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, var(--lilac-600), var(--rose-600));\n    display: grid; place-items: center;\n    color: white;\n    box-shadow: 0 6px 18px rgba(138, 92, 201, 0.35);\n    overflow: hidden;\n    flex-shrink: 0;\n  }\n  .logo-mark img { width: 100%; height: 100%; object-fit: cover; }\n\n  .brand-name {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-size: 1.15rem;\n    color: var(--lilac-700);\n    letter-spacing: -0.01em;\n    line-height: 1.1;\n  }\n  .brand-name small {\n    display: block;\n    font-family: 'Inter', sans-serif;\n    font-size: 0.65rem;\n    font-weight: 600;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--ink-mute);\n    margin-top: 3px;\n  }\n\n  .live-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 0.72rem;\n    font-weight: 600;\n    color: var(--lilac-700);\n    background: var(--lilac-100);\n    border: 1px solid var(--lilac-200);\n    padding: 6px 12px;\n    border-radius: 999px;\n    letter-spacing: 0.02em;\n  }\n  .live-dot {\n    width: 7px; height: 7px;\n    border-radius: 50%;\n    background: #22c55e;\n    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);\n    animation: pulse 1.8s ease-in-out infinite;\n  }\n  @keyframes pulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.6; transform: scale(0.85); }\n  }\n\n  /* ---------- HERO ---------- */\n  .hero {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 56px 24px 24px;\n    text-align: center;\n  }\n\n  .hero .eyebrow {\n    display: inline-block;\n    font-size: 0.72rem;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: var(--rose-600);\n    background: var(--rose-100);\n    padding: 7px 14px;\n    border-radius: 999px;\n    margin-bottom: 20px;\n  }\n\n  .hero h1 {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-size: clamp(2rem, 4.5vw, 3rem);\n    line-height: 1.1;\n    letter-spacing: -0.02em;\n    color: var(--ink);\n    margin-bottom: 16px;\n  }\n\n  .hero h1 .gradient {\n    background: linear-gradient(135deg, var(--lilac-600), var(--rose-600));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n\n  .hero p {\n    font-size: 1.02rem;\n    color: var(--ink-soft);\n    max-width: 560px;\n    margin: 0 auto;\n    line-height: 1.6;\n  }\n\n  /* ---------- CONTAINER ---------- */\n  .container {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 8px 24px 80px;\n  }\n\n  /* ---------- STATUS / LOADING ---------- */\n  .status-box {\n    text-align: center;\n    padding: 60px 24px;\n    color: var(--ink-soft);\n  }\n  .status-icon {\n    width: 56px; height: 56px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, var(--lilac-600), var(--rose-600));\n    display: grid; place-items: center;\n    margin: 0 auto 20px;\n    color: white;\n    font-size: 1.5rem;\n    box-shadow: 0 12px 28px rgba(138, 92, 201, 0.30);\n  }\n  .status-box p {\n    font-size: 0.95rem;\n    max-width: 420px;\n    margin: 0 auto;\n    line-height: 1.6;\n  }\n  .status-box strong { color: var(--ink); }\n\n  /* Skeleton */\n  .skeleton-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 20px;\n    margin-top: 8px;\n  }\n  @media (min-width: 720px) {\n    .skeleton-grid { grid-template-columns: 1fr 1fr; }\n  }\n  .skeleton-card {\n    background: var(--white);\n    border-radius: var(--radius-lg);\n    border: 1px solid var(--lilac-100);\n    overflow: hidden;\n  }\n  .skeleton-img {\n    height: 190px;\n    background: linear-gradient(90deg, var(--lilac-100) 25%, var(--lilac-200) 50%, var(--lilac-100) 75%);\n    background-size: 200% 100%;\n    animation: shimmer 1.5s ease-in-out infinite;\n  }\n  .skeleton-body { padding: 20px; }\n  .skeleton-line {\n    height: 12px;\n    border-radius: 6px;\n    background: linear-gradient(90deg, var(--lilac-100) 25%, var(--lilac-200) 50%, var(--lilac-100) 75%);\n    background-size: 200% 100%;\n    animation: shimmer 1.5s ease-in-out infinite;\n    margin-bottom: 10px;\n  }\n  .skeleton-line.w-40 { width: 40%; }\n  .skeleton-line.w-70 { width: 70%; }\n  .skeleton-line.w-90 { width: 90%; }\n  @keyframes shimmer {\n    0% { background-position: 200% 0; }\n    100% { background-position: -200% 0; }\n  }\n\n  /* ---------- ERROR ---------- */\n  .error-msg {\n    background: #fff8f8;\n    border: 1px solid #f5c6cb;\n    border-radius: var(--radius-md);\n    padding: 16px 20px;\n    color: #721c24;\n    font-size: 0.9rem;\n    margin-bottom: 24px;\n    display: none;\n    align-items: center;\n    gap: 10px;\n  }\n  .error-msg.visible { display: flex; }\n\n  /* ---------- GRID DE CARDS ---------- */\n  .cards-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n  @media (min-width: 720px) {\n    .cards-grid { grid-template-columns: 1fr 1fr; }\n  }\n\n  /* ---------- CARD ---------- */\n  .place-card {\n    background: var(--white);\n    border-radius: var(--radius-lg);\n    border: 1px solid rgba(230, 217, 247, 0.6);\n    overflow: hidden;\n    box-shadow: var(--shadow-sm);\n    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),\n                box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),\n                border-color 0.35s ease;\n    display: flex;\n    flex-direction: column;\n    animation: cardIn 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both;\n  }\n  .place-card:hover {\n    transform: translateY(-6px);\n    box-shadow: var(--shadow-lg);\n    border-color: var(--lilac-200);\n  }\n  @keyframes cardIn {\n    from { opacity: 0; transform: translateY(16px) scale(0.98); }\n    to   { opacity: 1; transform: translateY(0) scale(1); }\n  }\n\n  .card-image {\n    width: 100%;\n    height: 200px;\n    background: linear-gradient(135deg, var(--lilac-100), var(--lilac-200));\n    overflow: hidden;\n    position: relative;\n  }\n  .card-image img {\n    width: 100%; height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);\n  }\n  .place-card:hover .card-image img { transform: scale(1.06); }\n\n  .card-image .no-img {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    height: 100%;\n    color: var(--lilac-400);\n    font-size: 2.5rem;\n  }\n\n  /* gradiente sutil sobre a imagem */\n  .card-image::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, transparent 55%, rgba(31, 26, 42, 0.08) 100%);\n    pointer-events: none;\n  }\n\n  .card-body {\n    padding: 22px 24px 24px;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .card-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 0.68rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: var(--rose-600);\n    background: var(--rose-100);\n    padding: 5px 11px;\n    border-radius: 999px;\n    margin-bottom: 14px;\n    align-self: flex-start;\n  }\n  .card-tag::before {\n    content: '';\n    width: 5px; height: 5px;\n    border-radius: 50%;\n    background: var(--rose-600);\n  }\n\n  .card-title {\n    font-family: 'Fraunces', serif;\n    font-size: 1.35rem;\n    font-weight: 700;\n    color: var(--ink);\n    margin-bottom: 10px;\n    line-height: 1.25;\n    letter-spacing: -0.01em;\n  }\n\n  .card-message {\n    font-size: 0.94rem;\n    color: var(--ink-soft);\n    line-height: 1.65;\n    white-space: pre-line;\n    flex: 1;\n    word-wrap: break-word;\n  }\n\n  .card-meta {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 0.75rem;\n    font-weight: 500;\n    color: var(--ink-mute);\n    margin-top: 18px;\n    padding-top: 16px;\n    border-top: 1px solid var(--lilac-100);\n  }\n  .card-meta svg { flex-shrink: 0; }\n\n  /* ---------- FOOTER ---------- */\n  .site-footer {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 32px 24px 48px;\n    text-align: center;\n    border-top: 1px solid rgba(230, 217, 247, 0.6);\n    font-size: 0.82rem;\n    color: var(--ink-mute);\n  }\n  .site-footer .heart {\n    color: var(--rose-600);\n    display: inline-block;\n    animation: heartbeat 2s ease-in-out infinite;\n  }\n  @keyframes heartbeat {\n    0%, 100% { transform: scale(1); }\n    20% { transform: scale(1.15); }\n    40% { transform: scale(0.95); }\n    60% { transform: scale(1.1); }\n  }\n  .site-footer strong { color: var(--lilac-700); font-weight: 700; }\n\n  /* ---------- LAST UPDATE ---------- */\n  .last-update-bar {\n    text-align: center;\n    margin-top: 32px;\n    font-size: 0.75rem;\n    font-weight: 500;\n    color: var(--ink-mute);\n    letter-spacing: 0.02em;\n  }\n\n  /* ---------- MOBILE ---------- */\n  @media (max-width: 480px) {\n    .topbar-inner { padding: 12px 16px; }\n    .brand-name { font-size: 1rem; }\n    .brand-name small { font-size: 0.6rem; }\n    .hero { padding: 40px 20px 16px; }\n    .container { padding: 8px 16px 60px; }\n    .card-image { height: 170px; }\n    .card-body { padding: 18px 20px 20px; }\n    .card-title { font-size: 1.2rem; }\n  }\n</style>\n</head>\n<body>\n\n  <!-- HEADER STICKY -->\n  <header class=\"topbar\">\n    <div class=\"topbar-inner\">\n      <div class=\"brand-block\">\n        <div class=\"logo-mark\">\n          <img src=\"Captura de tela 2026-10-19 222907.jpg\" alt=\"Logo ViaFemini\">\n        </div>\n        <div class=\"brand-name\">\n          PatosTurista\n          <small>by ViaFemini</small>\n        </div>\n      </div>\n      <span class=\"live-badge\">\n        <span class=\"live-dot\"></span>\n        Ao vivo\n      </span>\n    </div>\n  </header>\n\n  <!-- HERO -->\n  <section class=\"hero\">\n    <span class=\"eyebrow\">Curadoria inteligente</span>\n    <h1>\n      Os melhores lugares<br>\n      para sair em <span class=\"gradient\">Patos‑PB</span>\n    </h1>\n    <p>\n      Recomendações selecionadas por IA, atualizadas automaticamente ao longo do dia. Feito com carinho para as mulheres de Patos.\n    </p>\n  </section>\n\n  <!-- CONTEÚDO -->\n  <main class=\"container\">\n    <div class=\"error-msg\" id=\"errorMsg\"></div>\n\n    <!-- Skeleton de carregamento -->\n    <div class=\"skeleton-grid\" id=\"skeletonGrid\">\n      <div class=\"skeleton-card\">\n        <div class=\"skeleton-img\"></div>\n        <div class=\"skeleton-body\">\n          <div class=\"skeleton-line w-40\"></div>\n          <div class=\"skeleton-line w-90\"></div>\n          <div class=\"skeleton-line w-70\"></div>\n        </div>\n      </div>\n      <div class=\"skeleton-card\">\n        <div class=\"skeleton-img\"></div>\n        <div class=\"skeleton-body\">\n          <div class=\"skeleton-line w-40\"></div>\n          <div class=\"skeleton-line w-90\"></div>\n          <div class=\"skeleton-line w-70\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Estado vazio -->\n    <div class=\"status-box\" id=\"statusBox\" style=\"display: none;\"></div>\n\n    <!-- Grid de cards -->\n    <div class=\"cards-grid\" id=\"cardsGrid\"></div>\n\n    <!-- Última verificação -->\n    <div class=\"last-update-bar\" id=\"lastUpdate\"></div>\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"site-footer\">\n    Feito com <span class=\"heart\">♥</span> para as mulheres de Patos‑PB · <strong>ViaFemini</strong>\n  </footer>\n\n  <script>\n    // =====================================================\n    // CONFIGURAÇÃO\n    // =====================================================\n    const NTFY_TOPIC = 'vfconecapatospb';\n    const NTFY_BASE  = 'https://ntfy.sh';\n    const POLL_INTERVAL = 30000;\n\n    // =====================================================\n    // ELEMENTOS\n    // =====================================================\n    const cardsGrid    = document.getElementById('cardsGrid');\n    const statusBox    = document.getElementById('statusBox');\n    const skeletonGrid = document.getElementById('skeletonGrid');\n    const errorMsgEl   = document.getElementById('errorMsg');\n    const lastUpdateEl = document.getElementById('lastUpdate');\n\n    // =====================================================\n    // ESTADO\n    // =====================================================\n    let lastMessageId = null;\n    let pollTimer     = null;\n    let isLoading     = false;\n\n    // =====================================================\n    // BUSCAR MENSAGENS\n    // =====================================================\n    async function fetchMessages(forceFullReload = false) {\n      if (isLoading) return;\n      isLoading = true;\n\n      if (forceFullReload) lastMessageId = null;\n\n      try {\n        let url = `${NTFY_BASE}/${NTFY_TOPIC}/json?poll=1`;\n        if (lastMessageId) url += `&since=${encodeURIComponent(lastMessageId)}`;\n\n        const response = await fetch(url, { cache: 'no-store' });\n        if (!response.ok) throw new Error(`Erro HTTP ${response.status}`);\n\n        const text = await response.text();\n        const lines = text.trim().split('\\n').filter(l => l.trim() !== '');\n\n        const messages = [];\n        let newestId = lastMessageId;\n\n        for (const line of lines) {\n          try {\n            const obj = JSON.parse(line);\n            if (obj.event !== 'message') continue;\n            if (!obj.message) continue;\n            messages.push(obj);\n            if (!newestId || obj.id > newestId) newestId = obj.id;\n          } catch (e) {}\n        }\n\n        if (messages.length > 0) {\n          renderMessages(messages);\n          if (newestId) lastMessageId = newestId;\n        } else if (forceFullReload && cardsGrid.children.length === 0) {\n          showEmptyState();\n        }\n\n        skeletonGrid.style.display = 'none';\n        statusBox.style.display = 'none';\n        errorMsgEl.classList.remove('visible');\n        atualizarHorario();\n\n      } catch (err) {\n        console.error('Erro ao buscar mensagens:', err);\n        if (cardsGrid.children.length === 0) {\n          skeletonGrid.style.display = 'none';\n          errorMsgEl.innerHTML = `\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n            Não foi possível carregar os locais agora. Verifique sua conexão.\n          `;\n          errorMsgEl.classList.add('visible');\n        }\n      } finally {\n        isLoading = false;\n        agendarProximaPoll();\n      }\n    }\n\n    // =====================================================\n    // RENDERIZAÇÃO\n    // =====================================================\n    function renderMessages(messages) {\n      skeletonGrid.style.display = 'none';\n      statusBox.style.display = 'none';\n\n      messages.sort((a, b) => (b.time || 0) - (a.time || 0));\n\n      messages.forEach((msg, i) => {\n        const card = createCard(msg);\n        card.style.animationDelay = `${i * 60}ms`;\n        cardsGrid.prepend(card);\n      });\n    }\n\n    function createCard(msg) {\n      const card = document.createElement('article');\n      card.className = 'place-card';\n\n      // Imagem\n      let imageUrl = null;\n      if (msg.attachment && msg.attachment.url) {\n        imageUrl = msg.attachment.url;\n      } else if (msg.url && /\\.(jpg|jpeg|png|webp|gif)(\\?|$)/i.test(msg.url)) {\n        imageUrl = msg.url;\n      } else if (msg.image) {\n        imageUrl = msg.image;\n      } else {\n        const urlRegex = /(https?:\\/\\/[^\\s]+\\.(?:jpg|jpeg|png|webp|gif)[^\\s]*)/i;\n        const match = msg.message.match(urlRegex);\n        if (match) imageUrl = match[1];\n      }\n\n      const imageDiv = document.createElement('div');\n      imageDiv.className = 'card-image';\n      if (imageUrl) {\n        const img = document.createElement('img');\n        img.src = imageUrl;\n        img.alt = msg.title || 'Foto do local';\n        img.loading = 'lazy';\n        img.onerror = () => { imageDiv.innerHTML = '<div class=\"no-img\">📍</div>'; };\n        imageDiv.appendChild(img);\n      } else {\n        imageDiv.innerHTML = '<div class=\"no-img\">📍</div>';\n      }\n      card.appendChild(imageDiv);\n\n      // Corpo\n      const body = document.createElement('div');\n      body.className = 'card-body';\n\n      if (msg.tags && msg.tags.length > 0) {\n        const tag = document.createElement('span');\n        tag.className = 'card-tag';\n        tag.textContent = msg.tags[0];\n        body.appendChild(tag);\n      }\n\n      const title = document.createElement('h2');\n      title.className = 'card-title';\n      title.textContent = msg.title || 'Local recomendado';\n      body.appendChild(title);\n\n      const messageP = document.createElement('p');\n      messageP.className = 'card-message';\n      let textContent = msg.message;\n      if (imageUrl && textContent.includes(imageUrl)) {\n        textContent = textContent.replace(imageUrl, '').trim();\n      }\n      messageP.textContent = textContent;\n      body.appendChild(messageP);\n\n      const meta = document.createElement('div');\n      meta.className = 'card-meta';\n      if (msg.time) {\n        const date = new Date(msg.time * 1000);\n        const formatted = date.toLocaleString('pt-BR', {\n          day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'\n        });\n        meta.innerHTML = `\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <polyline points=\"12 6 12 12 16 14\"></polyline>\n          </svg>\n          ${formatted}\n        `;\n      }\n      body.appendChild(meta);\n      card.appendChild(body);\n      return card;\n    }\n\n    // =====================================================\n    // ESTADO VAZIO\n    // =====================================================\n    function showEmptyState() {\n      skeletonGrid.style.display = 'none';\n      statusBox.style.display = 'block';\n      statusBox.innerHTML = `\n        <div class=\"status-icon\">🗺️</div>\n        <p><strong>Nenhuma recomendação ainda.</strong><br>\n        Assim que a IA enviar os primeiros locais para o tópico <strong>vfconecapatospb</strong>, eles aparecerão aqui automaticamente.</p>\n      `;\n    }\n\n    // =====================================================\n    // POLLING\n    // =====================================================\n    function agendarProximaPoll() {\n      if (pollTimer) clearTimeout(pollTimer);\n      pollTimer = setTimeout(() => fetchMessages(false), POLL_INTERVAL);\n    }\n\n    // =====================================================\n    // HORÁRIO\n    // =====================================================\n    function atualizarHorario() {\n      const agora = new Date();\n      const hh = String(agora.getHours()).padStart(2, '0');\n      const mm = String(agora.getMinutes()).padStart(2, '0');\n      lastUpdateEl.textContent = `Última verificação às ${hh}:${mm}`;\n    }\n\n    // =====================================================\n    // INICIALIZAÇÃO\n    // =====================================================\n    fetchMessages(true);\n  </script>\n</body>\n</html>",
